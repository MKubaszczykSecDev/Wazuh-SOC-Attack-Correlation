<!-- Example -->


<group name="ssh_custom_group,">

<!-- Custom Rule: Baseline for detecting Failed SSH Auth. Attempts -->

<rule id="100000" level="5">
    <if_sid>5760, 5716</if_sid>
    <description>SSH authentication failure detected</description>
  </rule>

<!-- Custom Rule for Detecting if the multiple failed SSH Auth. attempts came from the same IP -->

  <rule id="100001" level="10" frequency="8" timeframe="60">
    <if_matched_sid>100000</if_matched_sid>
    <same_srcip />
    <description>Multiple SSH authentication failures detected from the same IP address</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

<!-- Custom Rule for detecting direct root SSH Login Attempts -->

  <rule id="100002" level="12" frequency="3" timeframe="30">
    <if_matched_sid>100000</if_matched_sid>
    <match>root</match>
    <description>SSH root login attempt detected</description>
    <mitre>
      <id>T1078.003</id>
    </mitre>
  </rule>

<!-- Cutom Rule for detecting a Successful Login after Brute Force Attack -->

  <rule id="100003" level="14">
    <if_sid>5715</if_sid>
    <if_matched_sid>100001</if_matched_sid>
    <same_srcip />
    <description>Successful SSH login following a brute force attack</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

<!-- Custom Rule for auditing SSH Key Based Authentication Logins -->

  <rule id="100004" level="3" overwrite="yes">
    <if_sid>5715</if_sid>
    <match>publickey</match>
    <description>Successful SSH key based authentication</description>
    <mitre>
      <id>T1021.002</id>
    </mitre>
  </rule>

</group>

<!-- Custom Rule for Monitoring if sys auth. files have been modified or copied-->

<group name="syscheck,critical_sys_files,">
  <rule id="100010" level="13">
    <if_sid>550, 554</if_sid>
    <field name="file">^/etc/passwd|^/etc/shadow|^/etc/group</field>
    <description>System authentication file $(file) was modified or copied</description>
  </rule>
</group>

<!-- Custom Rule: Baseline for rule 100012, it collects currently running processes on agent -->

<group name="monitoring_for_netcat,">
<rule id="100011" level="0">
    <if_sid>530</if_sid>
    <match>^ossec: output: 'process list'</match>
    <description>Collecting running processes from endpoint</description>
  </rule>

<!-- Custom Rule for detecting if netcat/nc is running -->

  <rule id="100012" level="12" ignore="60">
    <if_sid>100011</if_sid>
    <match>nc -l|ncat -l|netcat -l</match>
    <description>Unauthorized listener detected. (Possible backdoor)</description>
    <mitre>
      <id>T1567</id>
      <id>T1059</id>
    </mitre>
    <group>backdoor_detection,process_monitor,</group>
  </rule>
</group>

<!-- Custom Group created for FIM detection rules -->
<!-- Custom Rule for detecting if files in the /srv/ftp directory have been viewed -->

<group name="FIM_Config,syscheck,audit,"> 

  <rule id="100020" level="7">
    <if_sid>80700</if_sid>
    <field name="audit.key">audit-ftp-read</field>
    <field name="audit.exe" negate="yes">/var/ossec/bin/wazuh-syscheckd</field>
    <description>File: /srv/ftp/$(audit.file.name) has been read using $(audit.command)</description>
  </rule>

  <rule id="100025" level="7">
    <if_sid>80700</if_sid>
    <field name="audit.key">audit-samba-read</field>
    <field name="audit.exe" negate="yes">/var/ossec/bin/wazuh-syscheckd</field>
    <description>File: /srv/samba/$(audit.file.name) has been read using $(audit.command)</description>
  </rule>

<!--Custom Rule for detecting if files in the /srv/samba directory have been altered -->

  <rule id="100021" level="10">
    <if_sid>550</if_sid>
    <field name="file">^/srv/samba/</field>
    <match>modified</match>
    <description>File $(file) has been modified</description>
    <mitre><id>T1565</id></mitre>
  </rule>

<!-- Custom Rule for detecting if files in the /srv/ftp or /srv/samba directories have been deleted -->

  <rule id="100022" level="12">
    <if_sid>553</if_sid>
    <field name="file">^/srv/ftp/|^/srv/samba/</field>
    <match>deleted</match>
    <description>File deleted: $(file)</description>
    <mitre><id>T1485</id></mitre>
  </rule>
</group>

<!-- Cutom Group created for detecting FTP anomalies -->
<!-- Custom Rule for detecting anonymous logins -->

<group name="FTP_detection">
  <rule id="100030" level="7" overwrite="yes">
    <if_sid>11402</if_sid>
    <match>anon</match>
    <description>Anonymous login attempt detected</description>
    <mitre><id>T1078</id></mitre>
  </rule>

<!-- Custom Rule: Baseline for detecting Failed FTP Auth. Attempts -->

  <rule id="100031" level="3">
    <if_sid>11403</if_sid>
    <description>FTP authentication failure detected</description>
  </rule>

<!-- Custom Rule for detecting FTP Brute Force attack attempts -->

  <rule id="100032" level="10" frequency="8" timeframe="60">
    <if_matched_sid>100031</if_matched_sid>
    <same_srcip />
    <description>FTP Brute force attack detected from same IP</description>
    <mitre><id>T1110</id></mitre>
  </rule>
</group>

<!-- Custom Group created for detecting SMB related anomalies -->
<!-- Custom Rule for detecting if a user uploaded files to the SMB public share -->

<group name="SMB_detection">
  <rule id="100040" level="7">
    <if_sid>554</if_sid> 
    <field name="file">^/srv/samba/</field>
    <description>A file has been uploaded to the public share</description>
  </rule>

<!-- Custom Rule for detecting if a user uploaded a file with the .php extension -->

  <rule id="100041" level="12">
    <if_sid>100040</if_sid>
    <field name="file">\.php$</field>
    <description>Dangerous file extension '.php' uploaded to SMB public share (Possible PHP Reverse Shell)</description>
    <mitre><id>T1570</id></mitre>
  </rule>
</group>

<!-- Custom Group created for detecting SMB Reverse Shell and Execution -->
<!-- Custom Rule for detecting if a file with .php extension has been uploaded to /var/www/html/uploads -->

<group name="RCE_Detection,syscheck,">
  <rule id="100050" level="10">
    <if_sid>554</if_sid>
    <match>.php</match> 
    <description>PHP Web Shell uploaded to $(file)</description>
    <mitre><id>T1105</id></mitre>
  </rule>

<!-- Custom Rule for detecting HTTP requests accessing uploaded PHP files -->

  <rule id="100051" level="12">
    <if_sid>31108</if_sid> 
    <regex>\.php</regex>
    <description>PHP script accessed (possible web shell execution)</description>
  </rule>

<!-- Custom Rule for detecting correlation between a recently uploaded PHP file
     and if that file was then executed -->

  <rule id="100052" level="15" timeframe="60">
    <if_sid>100051</if_sid>
    <if_matched_sid>100050</if_matched_sid>
    <description>Uploaded PHP file executed via HTTP</description>
    <mitre>
      <id>T1190</id>
      <id>T1105</id>
    </mitre>
  </rule>
</group>

<!-- Custom Group for detecting Data Exfiltration attempts through archieves -->
<!-- Custom Rule for detecting Archieve Creation -->

<group name="Data_Exflitration,syscheck,audit,">
  <rule id="100060" level="10">
    <if_sid>554</if_sid>
    <match>.zip|.tar|.gz|.7z</match>
    <description>Archive created in: $(file) (possible data exfiltration)</description>
    <mitre>
      <id>T1020</id>
      <id>T1560</id>
    </mitre>
  </rule>

<!-- Custom Rule for detecting  -->

  <rule id="100061" level="12">
    <if_sid>100020</if_sid>
    <field name="audit.command">vsftpd</field>
    <description>FTP GET command used to download file: $(audit.file.name)</description>
  </rule>

  <rule id="100062" level="12">
    <if_sid>100025</if_sid>
    <field name="audit.exe">/usr/sbin/smbd</field>
    <description>SMB Data download detected: $(audit.file.name)</description>
  </rule>
</group>
